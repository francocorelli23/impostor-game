    <!-- Kako se igra -->
    <string name="htp_title">Kako se igra</string>
    <string name="htp_subtitle">Šezdeset sekundi i spremni ste.</string>
    <string name="htp_step1_title">Postavi igru</string>
    <string name="htp_step1_body">Odaberite koliko vas igra, koliko impostora skrivate među sobom i koje su kategorije u igri.</string>
    <string name="htp_step2_title">Dodajte mobitel</string>
    <string name="htp_step2_body">Dodajte ga bilo kojim redom. Svaki igrač dodirne svoje ime, pogleda sam i opet sakrije. Svi vide istu tajnu riječ — osim impostora.</string>
    <string name="htp_step3_title">Recite natuknicu</string>
    <string name="htp_step3_body">Idite ukrug. Svaki igrač kaže jednu riječ ili kratku frazu o tajnoj riječi. Dovoljno jasno da dokažete da je znate, dovoljno nejasno da je ne odate.</string>
    <string name="htp_step4_title">Glasajte</string>
    <string name="htp_step4_body">Ponovno dodajte mobitel i svi tajno glasaju za onoga koga sumnjiče.</string>
    <string name="htp_step5_title">Otkrivanje</string>
    <string name="htp_step5_body">Posada pobjeđuje ako izglasa svakog impostora. Impostori pobjeđuju ako i jedan preživi.</string>
    <string name="htp_tip_title">Kućna pravila koja dobro rade</string>
    <string name="htp_tip_1">Natuknica mora biti jedna riječ ili vrlo kratka fraza.</string>
    <string name="htp_tip_2">Ne smijete ponoviti natuknicu koja je već rečena.</string>
    <string name="htp_tip_3">Impostor govori u sredini kruga, nikad prvi.</string>
    <string name="htp_tip_4">Dva kruga natuknica prije glasanja čine igru boljom.</string>

