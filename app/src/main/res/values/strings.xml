    <!-- How to play -->
    <string name="htp_title">How to Play</string>
    <string name="htp_subtitle">Sixty seconds and you are ready.</string>
    <string name="htp_step1_title">Set it up</string>
    <string name="htp_step1_body">Choose how many players are here, how many impostors to hide among them, and which categories are in play.</string>
    <string name="htp_step2_title">Pass the phone</string>
    <string name="htp_step2_body">Pass it around in any order. Each player taps their own name, looks alone, and hides it again. Everyone sees the same secret word — except the impostors.</string>
    <string name="htp_step3_title">Give a clue</string>
    <string name="htp_step3_body">Go around the circle. Each player says one word or short phrase about the secret word. Be clear enough to prove you know it, vague enough not to give it away.</string>
    <string name="htp_step4_title">Vote</string>
    <string name="htp_step4_body">Pass the phone again and everyone secretly votes for who they suspect.</string>
    <string name="htp_step5_title">Reveal</string>
    <string name="htp_step5_body">The crew wins if every impostor is voted out. The impostors win if even one survives.</string>
    <string name="htp_tip_title">House rules that work well</string>
    <string name="htp_tip_1">Clues must be a single word or a very short phrase.</string>
    <string name="htp_tip_2">You may not repeat a clue that has already been said.</string>
    <string name="htp_tip_3">The impostor speaks in the middle of the circle, never first.</string>
    <string name="htp_tip_4">Two rounds of clues before voting makes for a better game.</string>

