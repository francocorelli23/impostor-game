# Copy this file to keystore.properties (same folder as settings.gradle.kts) and fill it in.
# keystore.properties is git-ignored on purpose - never commit it or your .jks file.
#
# Create a keystore once with:
#   keytool -genkey -v -keystore impostor-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias impostor
#
# storeFile may be absolute or relative to the project root.

storeFile=impostor-release.jks
storePassword=CHANGE_ME
keyAlias=impostor
keyPassword=CHANGE_ME
